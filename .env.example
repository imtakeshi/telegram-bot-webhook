# Скопируйте в .env и заполните (токен от @BotFather, ID от @userinfobot или @getmyid_bot)
BOT_TOKEN=000000000:AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA
ADMIN_ID=123456789
CHANNEL_URL=@your_channel
SUPPORT_USERNAME=@your_support
PAYMENT_URL=https://example.com/oplata

# Webhook (для Render/хостингов). В Render обычно нужен webhook вместо polling.
# WEBHOOK_URL должен быть полным URL вида: https://your-service.onrender.com/webhook
WEBHOOK_URL=
WEBHOOK_PATH=/webhook

# Сколько рублей за 1 USD (для конвертации цен в доллары). Пример: 100 значит 1$ = 100₽
RUB_PER_USD=100
# URL API курса USD→RUB (используется онлайн, RUB_PER_USD — резерв)
USD_RUB_API_URL=https://open.er-api.com/v6/latest/USD
# Кэш курса в секундах, чтобы не дергать API слишком часто
RATE_CACHE_TTL_SEC=1800

# USDT TRC20 (TRON) — показывается при оплате
CRYPTO_WALLET_TRC20=TNcCnFM6q573qiQksJxnQFAb2cq7mZDDNv

# Районы берутся из интернета (Wikidata). Эти настройки опциональны.
WIKIDATA_SPARQL_URL=https://query.wikidata.org/sparql
DISTRICTS_MAX=12
DISTRICTS_CACHE_TTL_SEC=86400
